# JupyterHub API Token (generated in JupyterHub: File -> Hub Control Panel -> Token)
JUPYTERHUB_API_TOKEN="your_jupyterhub_api_token_here"

# JupyterHub proxy URL to internal Ollama service (Port 11434)
# Format: https://<jupyterhub-domain>/user/<username>/proxy/11434/v1
OLLAMA_BASE_URL="https://your-jupyterhub-domain.com/user/your-username/proxy/11434/v1"
